PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/darjeeling_dev
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY_HOPS=0

NODE_ENV=development
mockOTP=true
# Required when mockOTP=true: generate a random 32-byte hex JWT_SECRET in your private .env.
# See docs/engineering/development-auth.md. Never commit the generated key.

AUTH_COOKIE_SAME_SITE=strict
ACCESS_TOKEN_TTL=30m
JWT_AUDIENCE=darjeeling-stores-clients
AUTH_COOKIE_SECURE=false
JWT_ISSUER=darjeeling-stores-api
REFRESH_TOKEN_TTL=15d
