PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/darjeeling_dev
CORS_ORIGINS=http://localhost:3000
API_INTERNAL_ORIGIN=http://127.0.0.1:4000
TRUST_PROXY_HOPS=0

NODE_ENV=development
mockOTP=true
# Required when mockOTP=true: generate a random 32-byte hex JWT_SECRET in your private .env.
# See docs/engineering/development-auth.md. Never commit the generated key.
# Staff password login needs only JWT_SECRET; keep it in the private .env.
# Production requires mockOTP=false and AUTH_COOKIE_SECURE=true.

AUTH_COOKIE_SAME_SITE=strict
ACCESS_TOKEN_TTL=30m
JWT_AUDIENCE=darjeeling-stores-clients
AUTH_COOKIE_SECURE=false
JWT_ISSUER=darjeeling-stores-api
REFRESH_TOKEN_TTL=15d

# Public release/maintenance policy only; never put secrets here. Restart after changes.
PUBLIC_APP_CONFIG_JSON={}

# ---- Real backend (all optional; the API starts without them and says clearly what is unavailable) ----
# Delivery codes are locked at rest and tracking links are signed. When these are left out, a separate key for each is derived from
# JWT_SECRET, so there is never a built-in key. Set them to rotate independently. 32-byte hex each.
# ORDER_OTP_KEY=
# TRACKING_TOKEN_SECRET=
# Where customers open a tracking link (the link is /track/<token> under it). Without it, orders carry no tracking link.
# TRACKING_BASE_URL=https://darjeelingstores.example
# Doorstep UPI QR shown in the rider app. Both are needed together.
# UPI_VPA=darjeeling@okbank
# UPI_PAYEE_NAME=Darjeeling Stores
# Road travel times (Google Routes). Without it the straight-line estimate is used.
# GOOGLE_MAPS_API_KEY=

# Online payments (Razorpay). Without them online payment answers 503 and cash on delivery still works.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# Photos, voice notes and product images (Cloudinary). Without it uploads answer 503.
# CLOUDINARY_URL=cloudinary://key:secret@cloud-name
# Login codes by SMS (StartMessaging). Needs mockOTP=false. Set the key and template id together; without them OTP requests answer 503.
# The template uses the variables {{otp}} and {{appName}}.
# STARTMESSAGING_API_KEY=sm_live_...
# STARTMESSAGING_TEMPLATE_ID=
# STARTMESSAGING_APP_NAME=Darjeeling Stores
# Push (Firebase) and WhatsApp Business messages.
# FCM_SERVICE_ACCOUNT_FILE=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=

# Requests one client address may make per minute before the API answers 429 (health checks and provider callbacks are never limited). 0 turns it off.
# RATE_LIMIT_PER_MINUTE=600

# Development only: let a phone on your Wi-Fi reach the API (for the rider app). With mockOTP on, anyone on that network could use the 000000 login, so leave this unset otherwise.
# API_HOST=0.0.0.0
