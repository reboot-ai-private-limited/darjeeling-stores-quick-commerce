{
  "expo": {
    "name": "Darjeeling Stores",
    "slug": "darjeeling-customer",
    "scheme": "darjeelingstores",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "android": {
      "package": "in.darjeelingstores.customer",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#02670E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize"
    },
    "ios": { "bundleIdentifier": "in.darjeelingstores.customer", "buildNumber": "1", "supportsTablet": false },
    "web": { "bundler": "metro", "favicon": "./assets/favicon.png" },
    "plugins": [
      "expo-router",
      "expo-font",
      ["expo-splash-screen", { "image": "./assets/splash-icon.png", "backgroundColor": "#F6FBF4", "imageWidth": 200 }],
      ["expo-secure-store", { "faceIDPermission": false }],
      ["expo-image-picker", { "photosPermission": "Darjeeling Stores uses your photos so you can add a picture of your door or of a problem item.", "cameraPermission": "Darjeeling Stores uses the camera to take a picture of your door or of a problem item." }],
      ["expo-audio", { "microphonePermission": "Darjeeling Stores uses the microphone to record a voice note for your delivery partner.", "enableBackgroundPlayback": false, "enableBackgroundRecording": false }],
      ["expo-location", { "locationWhenInUsePermission": "Darjeeling Stores uses your location to find the nearest store and deliver to your door.", "locationAlwaysAndWhenInUsePermission": false, "locationAlwaysPermission": false, "motionUsagePermission": false, "locationFullAccuracyPermission": false }]
    ]
  }
}
